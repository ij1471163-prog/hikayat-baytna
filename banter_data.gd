static func pick(present: Array) -> Array:
	var keys: Array = []
	for i in ORDER.size():
		for j in range(i + 1, ORDER.size()):
			if ORDER[i] in present and ORDER[j] in present:
				keys.append("%s|%s" % [ORDER[i], ORDER[j]])
	if keys.is_empty(): return []
	var k: String = keys[randi() % keys.size()]
	var opts: Array = B.get(k, [])
	if opts.is_empty(): return []
	return opts[randi() % opts.size()]
